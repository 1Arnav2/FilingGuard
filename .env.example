# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=
TARGET_MODEL=
VERIFIER_MODEL=
SEC_USER_AGENT="Name email@example.com"
NUMERIC_REL_TOLERANCE=0.005
CACHE_DIR=.cache
# LLM spend limits in USD (D-024). The code refuses a cap above 7.00.
SPEND_WARN_USD=5.00
SPEND_CAP_USD=7.00
# Results directory read by the dashboard API (default: results)
# FILINGGUARD_RESULTS=results
# Static dashboard export served at / by the API (default: web/out)
# FILINGGUARD_WEB=web/out
# Live target route POST /api/target/answer (makes model calls). Only 1 turns it on; never on the public deploy.
FILINGGUARD_LIVE_TARGET=0
